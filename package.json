{
  "name": "docconversion",
  "version": "1.0.0",
  "description": "Offline document converter: 22 input formats to PDF, Word, Markdown, HTML, EPUB and more, including the clipboard and web pages.",
  "keywords": [
    "document-conversion",
    "pdf",
    "docx",
    "markdown",
    "epub",
    "ocr",
    "offline",
    "electron",
    "converter"
  ],
  "main": "./out/main/index.js",
  "desktopName": "docconversion.desktop",
  "author": "Stephen Genusa",
  "license": "MIT",
  "scripts": {
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "screenshots": "node scripts/screenshots.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:unpack": "npm run build && electron-builder --dir",
    "prebuild:win": "node scripts/native-for-target.mjs win32-x64-msvc",
    "build:win": "npm run build && electron-builder --win",
    "build:linux": "npm run build && electron-builder --linux",
    "build:e2e-core": "esbuild src/core/index.ts --bundle --platform=node --format=cjs --packages=external --outfile=out/e2e/core.cjs",
    "test:e2e": "npm run build:e2e-core && electron tests/e2e/matrix.cjs",
    "cli": "electron . convert",
    "test:cli": "node tests/e2e/cli-smoke.mjs",
    "pii:update": "PII_UPDATE=1 vitest run tests/pii"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@iarna/rtf-to-html": "^1.1.0",
    "@kenjiuno/decompressrtf": "^0.1.4",
    "@kenjiuno/msgreader": "^1.28.0",
    "@mozilla/readability": "^0.6.0",
    "@napi-rs/canvas": "^0.1.80",
    "@tiptap/extension-image": "^3.30.5",
    "@tiptap/extension-table": "^3.30.5",
    "@tiptap/html": "^3.30.5",
    "@tiptap/react": "^3.30.5",
    "@tiptap/starter-kit": "^3.30.5",
    "asciidoctor": "^4.0.11",
    "domhandler": "^6.0.1",
    "domutils": "^4.0.2",
    "highlight.js": "^11.12.0",
    "html-to-docx": "^1.8.0",
    "html-to-text": "^10.0.0",
    "htmlparser2": "^12.0.0",
    "iconv-lite": "^0.7.3",
    "jszip": "^3.10.1",
    "linkedom": "^0.18.13",
    "mammoth": "^1.12.0",
    "markdown-it": "^14.3.0",
    "node-ical": "^0.27.1",
    "papaparse": "^5.7.0",
    "pdfjs-dist": "^6.1.200",
    "postal-mime": "^3.0.0",
    "restructured": "^0.0.11",
    "rtf-stream-parser": "^4.0.0",
    "sanitize-html": "^2.17.6",
    "tesseract.js": "^7.0.0",
    "turndown": "^7.2.4",
    "turndown-plugin-gfm": "^1.0.2",
    "word-extractor": "^1.0.4",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@lingo-reader/mobi-parser": "^0.4.6",
    "@types/html-to-text": "^9.0.4",
    "@types/lodash": "^4.17.25",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^24.0.0",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/sanitize-html": "^2.16.0",
    "@types/turndown": "^5.0.6",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^43.1.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "happy-dom": "^20.12.0",
    "pdf-lib": "^1.17.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "reveal.js": "^6.0.1",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vitest": "^4.1.10"
  }
}
